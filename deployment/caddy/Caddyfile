# Caddy configuration for MaintMode — local/dev.
#
# Public API on :3000 (mapped to host :9000 in compose.yaml).
# Infra / status API on :3001 (mapped to host :9001).
# No TLS locally. Routing mirrors the legacy deployment/nginx.conf.
#
# For production HTTPS use deployment/caddy/Caddyfile.prod via the
# compose.app.prod.yaml overlay.
#
# Upstream uses docker service DNS (maintmode). The single maintmode
# process serves both the /auth/* and /maintmode/* surfaces. With
# `docker compose up --scale maintmode=N`, the name resolves to all
# replica IPs; the lb_* directives spread requests across them. Mirrors
# Caddyfile.prod so dev exercises the same health logic.
#
# Active health polls /readiness on the infra port (8001) every 2s and
# drops a replica that reports not-200 — including one that flipped to 503
# during graceful drain. Passive health (fail_duration /
# max_fails) plus lb_retries replay a request that errors mid-flight on a
# healthy peer. Restart Caddy after changing replica count so it
# re-resolves DNS.
#
# Perimeter rate limit: a coarse, per-client-IP anti-flood cap
# on the external /auth/* surface, provided by the caddy-ratelimit module
# (baked into our custom image — see deployment/caddy/Dockerfile). This is
# defense-in-depth IN FRONT of, not a replacement for, the app-level
# Valkey-backed business limiter on /login/oauth (30 RPM/IP):
#   - app limiter  : precise business limit, replica-shared via Valkey
#   - this limiter : coarse anti-flood before traffic reaches the app,
#                    Caddy in-memory (single Caddy per VM → consistent)
#
# Client IP: keyed on {http.request.remote.host}. In prod Caddy is the
# internet edge (see Caddyfile.prod), so that is the real client IP. We
# deliberately do NOT key on X-Forwarded-For / X-Real-IP and set no
# `trusted_proxies` — those headers are client-spoofable and would let an
# attacker forge a new IP per request to bypass the limit. If a trusted L7
# proxy is ever placed in front, configure `trusted_proxies` and switch the
# key to {http.request.client_ip}. (Locally every request arrives via the
# docker port-mapping, so all traffic shares one source IP — fine for dev.)
{
	# The rate_limit handler ships in a non-standard module, so it has no
	# default directive order — place it early, before reverse_proxy runs.
	order rate_limit before reverse_proxy

	# Expose Prometheus metrics on the admin endpoint's /metrics
	# (caddy_http_*, caddy_reverse_proxy_upstreams_healthy, etc.). The admin
	# API listens on :2019 across all interfaces so VictoriaMetrics can scrape
	# it over the theapp network (the default localhost:2019 is unreachable
	# from another container). Safe here because compose does NOT publish 2019
	# to the host — it stays internal to the theapp network.
	admin :2019
	metrics
}

(app_lb) {
	lb_policy round_robin
	lb_try_duration 5s
	lb_retries 2
	fail_duration 30s
	max_fails 3

	health_uri /readiness
	health_port 8001
	health_interval 2s
	health_timeout 2s
	health_status 2xx
}

# Coarse anti-flood ceiling for the external auth surface: 100 requests per
# 10s per client IP across all of /auth/*. Sized as anti-DDoS, not business
# logic — well above any legitimate single-user burst (/me + /refresh fan
# out to a handful of calls, not hundreds) yet low enough to blunt a flood.
# /login/oauth is rare; one ceiling covers them all and the precise per-IP
# login limit stays in the app (Valkey, 30 RPM). Over the limit → HTTP 429
# (the module sets Retry-After automatically).
# events/window are env-overridable so the e2e test stack — which drives the
# whole /auth surface from a single IP, doubled via tloc-api's -count=2 — can
# lift this coarse ceiling without weakening prod. Defaults match the original
# prod values, so prod behaviour is unchanged when the env vars are unset.
(auth_ratelimit) {
	rate_limit {
		zone auth_perimeter {
			key {http.request.remote.host}
			events {$AUTH_RATELIMIT_EVENTS:100}
			window {$AUTH_RATELIMIT_WINDOW:10s}
		}
	}
}

:3000 {
	encode gzip

	# Per-server HTTP metrics (caddy_http_requests_total,
	# caddy_http_request_duration_seconds, ...). The global `metrics` option
	# only exposes the /metrics endpoint + admin/upstream gauges; request-level
	# series require this directive inside each site block.
	metrics

	# JSON access log to stdout → promtail ships it to Loki under
	# {container_name="caddy"}. Without this, Caddy only logs internal
	# tls/config events, so HTTP status/duration/client_ip are unavailable
	# to the Caddy dashboard's log panels.
	log {
		output stdout
		format json
	}

	handle_path /auth/* {
		import auth_ratelimit
		reverse_proxy maintmode:8000 {
			import app_lb
		}
	}

	handle_path /maintmode/* {
		reverse_proxy maintmode:8000 {
			import app_lb
		}
	}

	root * /var/www/html/publicapi
	file_server
}

:3001 {
	encode gzip

	# Per-server HTTP metrics (see :3000).
	metrics

	# JSON access log → Loki (see :3000).
	log {
		output stdout
		format json
	}

	handle_path /auth/* {
		reverse_proxy maintmode:8001 {
			import app_lb
		}
	}

	handle_path /maintmode/* {
		reverse_proxy maintmode:8001 {
			import app_lb
		}
	}

	# MailPit inbox (dev only). The mailpit container runs with MP_WEBROOT=mail,
	# so its UI lives under /mail and serves its own assets from there — proxy
	# the prefix through unchanged (handle, not handle_path). No app_lb: mailpit
	# is a single container with no /readiness endpoint.
	handle /mail/* {
		reverse_proxy mailpit:8025
	}

	root * /var/www/html/infra
	file_server
}
