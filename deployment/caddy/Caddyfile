# Caddy configuration for MaintMode — local/dev.
#
# Public API on :3000 (mapped to host :9000 in compose.yaml).
# Infra / status API on :3001 (mapped to host :9001).
# No TLS locally. Routing mirrors the legacy deployment/nginx.conf.
#
# For production HTTPS use deployment/caddy/Caddyfile.prod via the
# compose.app.prod.yaml overlay.
#
# Upstreams use docker service DNS (auth, maintmode). With
# `docker compose up --scale auth=N --scale maintmode=N`, the names
# resolve to all replica IPs; the lb_* directives spread requests,
# eject a bad replica for 30s after 3 consecutive failures, and retry
# a failed request on a peer. Restart Caddy after changing replica count
# so it re-resolves DNS.

(app_lb) {
	lb_policy round_robin
	lb_try_duration 5s
	lb_retries 2
	fail_duration 30s
	max_fails 3
}

:3000 {
	encode gzip

	handle_path /auth/* {
		reverse_proxy auth:8000 {
			import app_lb
		}
	}

	handle_path /maintmode/* {
		reverse_proxy maintmode:8000 {
			import app_lb
		}
	}

	root * /var/www/html/publicapi
	file_server
}

:3001 {
	encode gzip

	handle_path /auth/* {
		reverse_proxy auth:8001 {
			import app_lb
		}
	}

	handle_path /maintmode/* {
		reverse_proxy maintmode:8001 {
			import app_lb
		}
	}

	root * /var/www/html/infra
	file_server
}
