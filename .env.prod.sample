# Production environment variables for single-VM Docker Compose deployment.
#
# Copy to .env.prod (gitignored) and fill in real values.
# Loaded automatically by `make prod-up` via docker compose's --env-file flag.

# ---- Public hostname & TLS ----
# DNS A record must point to this VM's public IP.
DOMAIN=maintmode.example.com
# Email for Let's Encrypt cert expiry notifications.
ACME_EMAIL=ops@example.com

# ---- Container images ----
# Override registry if not using the default GHCR path.
# MAINTMODE_IMAGE=ghcr.io/ruko1202/maintmode/maintmode
# AUTH_IMAGE=ghcr.io/ruko1202/maintmode/auth
MAINTMODE_IMAGE_TAG=latest
AUTH_IMAGE_TAG=latest

# ---- Grafana ----
# REQUIRED: change from default admin/admin.
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# ---- Alerting (Telegram) ----
# Alertmanager reads the Telegram bot token from a file, not from this
# env file, so the secret stays out of shell history and process env.
# chat_id is set directly in monitoring/config/alertmanager.yml (it is
# not secret).
# To enable Telegram alerts in prod:
#   1. Create a Telegram bot via @BotFather and copy its token.
#   2. Add the bot to the target chat / channel and grant post permission.
#   3. Find the chat_id (negative for groups/supergroups) and edit
#      monitoring/config/alertmanager.yml chat_id field.
#   4. echo "<bot-token>" > deployment/infra/prod/telegram_bot_token
#   5. chmod 600 deployment/infra/prod/telegram_bot_token
# See deployment/infra/prod/telegram_bot_token.sample and
# maintmode-docs/ops/monitoring.md for details.
