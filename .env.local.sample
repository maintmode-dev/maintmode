# Local development environment variables.
#
# Copy to .env.local (gitignored) and fill in with absolute paths
# matching your checkout location. Loaded by .air.toml when running
# `make air` for live-reload development.
#
# `make run` and `make tloc` set these variables directly in the
# shell and don't need .env.local — only air does, because it spawns
# the app as a child process with its own environment.

MAINTMODE_CONFIG_DIR=/absolute/path/to/maintmode/deployment/maintmode/local
MAINTMODE_AUTHZ_DIR=/absolute/path/to/maintmode/deployment/maintmode/authz
