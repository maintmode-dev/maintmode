# Local development environment variables.
#
# Copy to .env.local (gitignored) and fill in with absolute paths
# matching your checkout location. Loaded by .air.toml when running
# `make air` for live-reload development.
#
# `make run` and `make tloc` set these variables directly in the
# shell and don't need .env.local — only air does, because it spawns
# the app as a child process with its own environment.

MAINTMODE_APP_CONFIG_PATH=/absolute/path/to/maintmode/deployment/maintmode/local/app.config.yaml
MAINTMODE_APP_SECRETS_PATH=/absolute/path/to/maintmode/deployment/maintmode/local/app.secrets.yaml

AUTH_APP_CONFIG_PATH=/absolute/path/to/maintmode/deployment/auth/local/app.config.yaml
AUTH_APP_SECRETS_PATH=/absolute/path/to/maintmode/deployment/auth/local/app.secrets.yaml
