        },
        "/api/v1/maintenances/{id}/approve": {
            "post": {
                "description": "Approves a maintenance draft by ID using an observed revision and conflict snapshot.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Maintenances"
                ],
                "summary": "Approve maintenance draft",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Maintenance ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Approve maintenance request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/apimodels.ApproveDraftMaintRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Maintenance approved"
                    },
                    "400": {
                        "description": "Invalid request or forbidden status transition",
