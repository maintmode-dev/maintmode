# Resolved secrets for EVERY environment — never committed, not just prod.
# dev/local/test values are throwaway, but they are still real credentials
# (a leaked GOCSPX- secret is live whatever we call the folder), and the
# committed copies had to be rotated once already. Only *.sample.yaml is
# tracked; restore a working file with:
#   cp deployment/maintmode/<env>/app.secrets.sample.yaml \
#      deployment/maintmode/<env>/app.secrets.yaml
deployment/**/app.secrets.yaml

