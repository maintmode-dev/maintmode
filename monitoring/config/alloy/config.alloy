// Continuous profiling of maintmode through Pyroscope (pull model).
//
// Alloy itself does NOT store profiles — it collects them from the application's
// pprof endpoints and forwards them to Pyroscope. The chain: discovery.docker
// (find the maintmode replicas) -> discovery.relabel (build the <ip>:8001 address
// and set service_name) -> pyroscope.scrape (take the profiles) ->
// pyroscope.write (hand them to Pyroscope).

// 1. Where the profiles are written.
pyroscope.write "local_pyroscope" {
	endpoint {
		url = "http://pyroscope:4040"
	}
}

// 2. Target discovery through Docker.
//    We take ALL containers and filter by the prometheus.service=maintmode label
//    (the same label by which Prometheus finds maintmode). That covers horizontal
//    scaling with `docker compose up --scale maintmode=N`: discovery yields one
//    target per replica, so no static target is needed.
discovery.docker "maintmode" {
	host = "unix:///var/run/docker.sock"

	filter {
		name   = "label"
		values = ["prometheus.service=maintmode"]
	}
}

// 3. Turn the discovered containers into scrapeable targets:
//    - __address__ = <container ip in the theapp network>:8001 (the pprof port
//      lives on the infra server and is not published outside, so the port is
//      pinned as a literal);
//    - service_name = maintmode — the tag by which profiles are found in Grafana.
discovery.relabel "maintmode" {
	targets = discovery.docker.maintmode.targets

	rule {
		source_labels = ["__meta_docker_network_ip"]
		target_label  = "__address__"
		replacement   = "${1}:8001"
	}

	rule {
		target_label = "service_name"
		replacement  = "maintmode"
	}
}

// 4. Scrape the standard Go pprof profiles from every discovered replica.
pyroscope.scrape "maintmode_app" {
	targets    = discovery.relabel.maintmode.output
	forward_to = [pyroscope.write.local_pyroscope.receiver]

	// How often profiles are taken from each replica. Unset -> Alloy defaults:
	// scrape_interval = 15s, scrape_timeout = 18s. 15s means profiling is almost
	// continuous (a CPU profile is taken over a ~10-15s window), which puts a
	// constant small load on the application and grows the volume in Pyroscope
	// with many replicas. Uncomment and raise it (e.g. 60s) for a rarer/cheaper run.
	// scrape_interval = "15s"
	// scrape_timeout  = "18s"

	// Collect every profile type: CPU, memory, goroutines, block, mutex.
	profiling_config {
		profile.process_cpu { enabled = true }
		profile.memory { enabled = true }
		profile.goroutine { enabled = true }
		profile.block { enabled = true }
		profile.mutex { enabled = true }
	}
}
