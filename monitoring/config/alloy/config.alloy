// 1. Куда пишем данные (Receiver)
pyroscope.write "local_pyroscope" {
	endpoint {
		url = "http://pyroscope:4040"
	}
}

// 2. Откуда забираем данные (Scraper)
pyroscope.scrape "maintmode_app" {
	targets = [
		{
			// Имя твоего Go-контейнера в docker-compose и порт pprof
			"__address__"  = "maintmode:8001",
			// Тег, по которому ты будешь искать профили в Графане
			"service_name" = "maintmode",
		},
	]

	// Передаем собранное в блок записи
	forward_to = [pyroscope.write.local_pyroscope.receiver]

	// Говорим собирать все типы профилей (CPU, память, горутины)
	profiling_config {
		profile.process_cpu { enabled = true }
		profile.memory { enabled = true }
		profile.goroutine { enabled = true }
		profile.block { enabled = true }
		profile.mutex { enabled = true }
	}
}
