{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "10s",
  "schemaVersion": 42,
  "tags": ["maintmode", "postgres"],
  "templating": {
    "list": [
      {
        "current": { "text": "postgres", "value": "postgres" },
        "datasource": { "type": "prometheus", "uid": "vm_ds" },
        "definition": "label_values(pg_up, service_name)",
        "includeAll": false,
        "label": "Service",
        "name": "service",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(pg_up, service_name)",
          "refId": "vmVar"
        },
        "refresh": 2,
        "regex": "",
        "type": "query"
      },
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "vm_ds" },
        "definition": "label_values(pg_stat_database_numbackends{service_name=~\"$service\"}, datname)",
        "includeAll": true,
        "label": "Database",
        "multi": true,
        "name": "datname",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(pg_stat_database_numbackends{service_name=~\"$service\"}, datname)",
          "refId": "vmVar"
        },
        "refresh": 2,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PostgreSQL Database",
  "uid": "000000039",
  "version": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" } }, "type": "value" },
            { "options": { "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "pg_up{service_name=~\"$service\"}", "refId": "A" } ],
      "title": "Status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } } },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "sum(pg_stat_database_numbackends{service_name=~\"$service\"})", "refId": "A" } ],
      "title": "Active Connections",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Backends in use / max_connections.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "targets": [ { "expr": "sum(pg_stat_database_numbackends{service_name=~\"$service\"}) / max(pg_settings_max_connections{service_name=~\"$service\"})", "refId": "A" } ],
      "title": "Connection Pool Utilization",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "shared_buffers cache hit ratio across all databases.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.99 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "targets": [ { "expr": "sum(rate(pg_stat_database_blks_hit{service_name=~\"$service\"}[5m])) / clamp_min((sum(rate(pg_stat_database_blks_hit{service_name=~\"$service\"}[5m])) + sum(rate(pg_stat_database_blks_read{service_name=~\"$service\"}[5m]))), 1)", "refId": "A" } ],
      "title": "Cache Hit Ratio",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } } },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "sum(pg_database_size_bytes{service_name=~\"$service\", datname=~\"$datname\"})", "refId": "A" } ],
      "title": "Total DB Size",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "id": 100,
      "title": "Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{service_name=~\"$service\", datname=~\"$datname\"}[$__rate_interval]))", "legendFormat": "{{datname}} commits", "refId": "A" },
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{service_name=~\"$service\", datname=~\"$datname\"}[$__rate_interval]))", "legendFormat": "{{datname}} rollbacks", "refId": "B" }
      ],
      "title": "Transactions/s (commit & rollback)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "rows", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_tup_inserted{service_name=~\"$service\", datname=~\"$datname\"}[$__rate_interval]))", "legendFormat": "inserted", "refId": "A" },
        { "expr": "sum(rate(pg_stat_database_tup_updated{service_name=~\"$service\", datname=~\"$datname\"}[$__rate_interval]))", "legendFormat": "updated", "refId": "B" },
        { "expr": "sum(rate(pg_stat_database_tup_deleted{service_name=~\"$service\", datname=~\"$datname\"}[$__rate_interval]))", "legendFormat": "deleted", "refId": "C" },
        { "expr": "sum(rate(pg_stat_database_tup_fetched{service_name=~\"$service\", datname=~\"$datname\"}[$__rate_interval]))", "legendFormat": "fetched", "refId": "D" }
      ],
      "title": "Tuples/s",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Connections, Locks & Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (datname) (pg_stat_database_numbackends{service_name=~\"$service\", datname=~\"$datname\"})", "legendFormat": "{{datname}}", "refId": "A" }
      ],
      "title": "Active Connections by Database",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (mode) (pg_locks_count{service_name=~\"$service\", datname=~\"$datname\"})", "legendFormat": "{{mode}}", "refId": "A" }
      ],
      "title": "Locks by Mode",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_deadlocks{service_name=~\"$service\", datname=~\"$datname\"}[$__rate_interval]))", "legendFormat": "deadlocks/s", "refId": "A" },
        { "expr": "sum(rate(pg_stat_database_temp_files{service_name=~\"$service\", datname=~\"$datname\"}[$__rate_interval]))", "legendFormat": "temp files/s", "refId": "B" }
      ],
      "title": "Deadlocks & Temp Files",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "pg_database_size_bytes{service_name=~\"$service\", datname=~\"$datname\"}", "legendFormat": "{{datname}}", "refId": "A" }
      ],
      "title": "Database Size",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 12,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "max(pg_stat_activity_max_tx_duration{service_name=~\"$service\", datname=~\"$datname\"})", "legendFormat": "longest tx", "refId": "A" }
      ],
      "title": "Longest Running Transaction",
      "type": "timeseries"
    }
  ]
}
