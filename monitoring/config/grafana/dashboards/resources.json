{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "10s",
  "schemaVersion": 42,
  "tags": ["maintmode", "resources"],
  "templating": {
    "list": [
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "vm_ds" },
        "definition": "label_values(container_cpu_usage_seconds_total{name=~\".+\"}, service_name)",
        "description": "Container to scope the per-container panels. Type 'maintmode' to find the app — no need to edit container_name filters.",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(container_cpu_usage_seconds_total{name=~\".+\"}, service_name)",
          "refId": "vmVar"
        },
        "refresh": 2,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Resources (host & containers)",
  "uid": "maintmode-resources",
  "version": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Host — available capacity",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Total logical CPU cores on the VM.",
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } } },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "machine_cpu_cores", "refId": "A" } ],
      "title": "CPU Cores",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Total physical memory on the VM.",
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "node_memory_MemTotal_bytes", "refId": "A" } ],
      "title": "Total Memory",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Host memory in use = total - available.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.9 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "targets": [ { "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A" } ],
      "title": "Host Memory Used",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Root filesystem used = 1 - avail/size.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.85 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 13, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "targets": [ { "expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"})", "refId": "A" } ],
      "title": "Root Disk Used",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "1-minute load average.",
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "node_load1", "refId": "A" } ],
      "title": "Load (1m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Host CPU utilization = 1 - idle fraction, averaged across cores.",
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))", "legendFormat": "cpu used", "refId": "A" }
      ],
      "title": "Host CPU Utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Host network throughput across non-loopback interfaces.",
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo\"}[$__rate_interval]))", "legendFormat": "rx", "refId": "A" },
        { "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo\"}[$__rate_interval]))", "legendFormat": "tx", "refId": "B" }
      ],
      "title": "Host Network I/O",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Containers — consumed (select with $service)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Per-container CPU usage in cores (rate of cpu seconds).",
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (service_name) (rate(container_cpu_usage_seconds_total{name=~\".+\", service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{service_name}}", "refId": "A" }
      ],
      "title": "Container CPU (cores)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Per-container working-set memory (the cgroup metric the OOM killer watches).",
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (service_name) (container_memory_working_set_bytes{name=~\".+\", service_name=~\"$service\"})", "legendFormat": "{{service_name}}", "refId": "A" }
      ],
      "title": "Container Memory (working set)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Per-container network receive + transmit rate.",
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 23 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (service_name) (rate(container_network_receive_bytes_total{name=~\".+\", service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{service_name}} rx", "refId": "A" },
        { "expr": "sum by (service_name) (rate(container_network_transmit_bytes_total{name=~\".+\", service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{service_name}} tx", "refId": "B" }
      ],
      "title": "Container Network I/O",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "Each container's working-set memory as a share of total host memory — consumed vs available, no per-container limit required (this stack sets none).",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "align": "auto", "cellOptions": { "type": "gauge", "mode": "lcd" } },
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "red", "value": 0.5 } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "service_name" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "auto" } } ] }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 23 },
      "id": 11,
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Value", "desc": true } ] },
      "targets": [
        { "expr": "sum by (service_name) (container_memory_working_set_bytes{name=~\".+\", service_name=~\"$service\"}) / scalar(node_memory_MemTotal_bytes)", "format": "table", "instant": true, "refId": "A" }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ],
      "title": "Container Memory (% of host total)",
      "type": "table"
    }
  ]
}
