{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "10s",
  "schemaVersion": 42,
  "tags": ["maintmode", "redis"],
  "templating": {
    "list": [
      {
        "current": { "text": "redis", "value": "redis" },
        "datasource": { "type": "prometheus", "uid": "vm_ds" },
        "definition": "label_values(redis_up, service_name)",
        "includeAll": false,
        "label": "Service",
        "name": "service",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(redis_up, service_name)",
          "refId": "vmVar"
        },
        "refresh": 2,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Redis",
  "uid": "xDLNRKUWz",
  "version": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" } }, "type": "value" },
            { "options": { "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "redis_up{service_name=~\"$service\"}", "refId": "A" } ],
      "title": "Status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } } },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "sum(redis_connected_clients{service_name=~\"$service\"})", "refId": "A" } ],
      "title": "Connected Clients",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "used_memory / maxmemory, only when a maxmemory limit is configured. This stack runs Redis with maxmemory=0 (unbounded), so this panel is intentionally empty — track absolute usage in the Memory Usage timeseries below instead.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "no maxmemory limit set",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.95 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "targets": [ { "expr": "sum(redis_memory_used_bytes{service_name=~\"$service\"}) / (sum(redis_memory_max_bytes{service_name=~\"$service\"}) > 0)", "refId": "A" } ],
      "title": "Memory Utilization",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "keyspace_hits / (hits + misses) over 5m.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "targets": [ { "expr": "sum(rate(redis_keyspace_hits_total{service_name=~\"$service\"}[5m])) / clamp_min((sum(rate(redis_keyspace_hits_total{service_name=~\"$service\"}[5m])) + sum(rate(redis_keyspace_misses_total{service_name=~\"$service\"}[5m]))), 1)", "refId": "A" } ],
      "title": "Keyspace Hit Ratio",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } } },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "sum(redis_db_keys{service_name=~\"$service\"})", "refId": "A" } ],
      "title": "Total Keys",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "id": 100,
      "title": "Throughput & Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(redis_commands_processed_total{service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "commands/s", "refId": "A" }
      ],
      "title": "Commands Processed/s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "topk(10, sum by (cmd) (rate(redis_commands_total{service_name=~\"$service\"}[$__rate_interval])))", "legendFormat": "{{cmd}}", "refId": "A" }
      ],
      "title": "Commands/s by Type (top 10)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Memory, Keys & Network",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(redis_memory_used_bytes{service_name=~\"$service\"})", "legendFormat": "used", "refId": "A" },
        { "expr": "sum(redis_memory_max_bytes{service_name=~\"$service\"}) > 0", "legendFormat": "maxmemory", "refId": "B" }
      ],
      "title": "Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (db) (redis_db_keys{service_name=~\"$service\"})", "legendFormat": "{{db}} keys", "refId": "A" },
        { "expr": "sum(rate(redis_evicted_keys_total{service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "evicted/s", "refId": "B" },
        { "expr": "sum(rate(redis_expired_keys_total{service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "expired/s", "refId": "C" }
      ],
      "title": "Keys (by db) / Evictions / Expirations",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(redis_net_input_bytes_total{service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "input", "refId": "A" },
        { "expr": "sum(rate(redis_net_output_bytes_total{service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "output", "refId": "B" }
      ],
      "title": "Network I/O",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(redis_connected_clients{service_name=~\"$service\"})", "legendFormat": "connected", "refId": "A" },
        { "expr": "sum(redis_blocked_clients{service_name=~\"$service\"})", "legendFormat": "blocked", "refId": "B" }
      ],
      "title": "Clients",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "description": "allocator fragmentation ratio (>1.5 sustained warrants attention).",
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 12,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "avg(redis_mem_fragmentation_ratio{service_name=~\"$service\"})", "legendFormat": "fragmentation ratio", "refId": "A" }
      ],
      "title": "Memory Fragmentation Ratio",
      "type": "timeseries"
    }
  ]
}
